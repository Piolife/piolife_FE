{
  "expo": {
    "name": "piolife",
    "slug": "piolife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#0E16FF"
      },
      "permissions": ["android.permission.RECORD_AUDIO"],
      "package": "com.kaodinna.piolife"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E16FF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CONZOT+ to access your photos",
          "cameraPermission": "Allow CONZOT+ to access your camera"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a4251324-f5d6-4acb-a166-fe1053cd8170"
      }
    }
  }
}
